{
  "schemaVersion": 1,
  "id": "aaronmompie-client",
  "name": "Hardcore Client",
  "version": "${version}",
  "description": "HUD, statistics screen, death drama and freeze visuals. Required for every player.",
  "authors": ["hardcode-mod"],
  "environment": "client",
  "entrypoints": {
    "client": [
      { "adapter": "kotlin", "value": "com.aaronmompie.client.HardcoreClientMod" }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "${minecraft_version}"
  }
}
