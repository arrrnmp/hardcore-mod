# Local dev run directories (Fabric/Velocity working dirs) - anchored to each module's root
# (no bare "run/") since "run" is also a Kotlin source package (com.hardcode.game.run).
/proxy/run/
/game-server/run/
/limbo-server/run/
/runs/

# Manual local playtest environment (real standalone Fabric servers, downloaded
# vanilla/loader/mod jars, world saves) - see local-test/README.md
/local-test/
# Stray Fabric installer artifact left at the repo root if fabric-server-launch.jar is ever
# accidentally invoked from here instead of a local-test/* directory.
/fabric-server-launcher.properties

# Logs / local config
*.log
.env
local.properties

