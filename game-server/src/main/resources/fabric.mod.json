{
  "schemaVersion": 1,
  "id": "aaronmompie-game",
  "name": "Hardcore Game Server",
  "version": "${version}",
  "description": "Run lifecycle, mass-spectator-on-death, freeze-on-disconnect and Hall of Shame logic for the game server.",
  "authors": ["hardcode-mod"],
  "environment": "server",
  "entrypoints": {
    "main": [
      { "adapter": "kotlin", "value": "com.aaronmompie.game.HardcoreGameMod" }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "${minecraft_version}"
  }
}
